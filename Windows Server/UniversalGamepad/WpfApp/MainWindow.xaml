<Window x:Class="UniversalGamepad.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TactPad" Height="550" Width="900" MinHeight="480" MinWidth="800"
        Background="#121212" Foreground="#FFFFFF" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Side Control Panel -->
        <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#2D2D2D" BorderThickness="0,0,1,0" Padding="24">
            <Grid>
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="TACTPAD" FontSize="22" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,4"/>
                    <TextBlock Text="Wireless Mobile Gamepad" FontSize="12" Foreground="#666666" Margin="0,0,0,32"/>

                    <!-- Server Status -->
                    <TextBlock Text="EMULATION STATUS" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Fill="#FF3B30" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtStatus" Text="Server Inactive" FontSize="14" FontWeight="SemiBold" Foreground="#888888"/>
                    </StackPanel>

                    <!-- Broadcast Status -->
                    <TextBlock Text="NETWORK BROADCAST" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Ellipse x:Name="DiscoveryIndicator" Width="10" Height="10" Fill="#FF3B30" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtDiscovery" Text="Discovery Disabled" FontSize="14" FontWeight="SemiBold" Foreground="#888888"/>
                    </StackPanel>

                    <!-- Connection Properties -->
                    <TextBlock Text="CONNECTION PROPERTIES" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,8"/>
                    <Border Background="#252526" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                        <Grid>
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="Local IP Address" FontSize="11" Foreground="#888888"/>
                                <TextBlock x:Name="TxtIpAddress" Text="127.0.0.1" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnRefreshIp" Content="🔄" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="Transparent" BorderBrush="Transparent" Foreground="#888888" FontSize="14" 
                                    Cursor="Hand" Click="BtnRefreshIp_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Trigger Toggle Buttons -->
                <StackPanel VerticalAlignment="Bottom">
                    <Button x:Name="BtnToggleDiscovery" Content="Enable Discovery" Margin="0,0,0,12"
                            Background="#2D2D30" Foreground="White" FontWeight="Bold" Padding="12" FontSize="13"
                            Cursor="Hand" Click="BtnToggleDiscovery_Click">
                        <Button.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="BtnToggleServer" Content="Start Emulation"
                            Background="#007ACC" Foreground="White" FontWeight="Bold" Padding="16" FontSize="14"
                            Cursor="Hand" Click="BtnToggleServer_Click">
                        <Button.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right Side Live Slots Panel -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Virtual Slots Status" FontSize="18" FontWeight="SemiBold" Margin="8,0,0,16"/>

            <UniformGrid Grid.Row="1" Columns="2" Rows="2">
                <!-- Controller Slot 1 -->
                <Border x:Name="SlotBorder1" Background="#1E1E1E" CornerRadius="8" BorderBrush="#2D2D2D" BorderThickness="1" Margin="8" Padding="20">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="VIRTUAL CONTROLLER 1" FontSize="11" FontWeight="Bold" Foreground="#444444" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SlotIcon1" Text="🎮" FontSize="42" HorizontalAlignment="Center" Margin="0,12"/>
                        <TextBlock x:Name="SlotTxt1" Text="Disconnected" FontSize="13" Foreground="#444444" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Controller Slot 2 -->
                <Border x:Name="SlotBorder2" Background="#1E1E1E" CornerRadius="8" BorderBrush="#2D2D2D" BorderThickness="1" Margin="8" Padding="20">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="VIRTUAL CONTROLLER 2" FontSize="11" FontWeight="Bold" Foreground="#444444" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SlotIcon2" Text="🎮" FontSize="42" HorizontalAlignment="Center" Margin="0,12"/>
                        <TextBlock x:Name="SlotTxt2" Text="Disconnected" FontSize="13" Foreground="#444444" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Controller Slot 3 -->
                <Border x:Name="SlotBorder3" Background="#1E1E1E" CornerRadius="8" BorderBrush="#2D2D2D" BorderThickness="1" Margin="8" Padding="20">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="VIRTUAL CONTROLLER 3" FontSize="11" FontWeight="Bold" Foreground="#444444" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SlotIcon3" Text="🎮" FontSize="42" HorizontalAlignment="Center" Margin="0,12"/>
                        <TextBlock x:Name="SlotTxt3" Text="Disconnected" FontSize="13" Foreground="#444444" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Controller Slot 4 -->
                <Border x:Name="SlotBorder4" Background="#1E1E1E" CornerRadius="8" BorderBrush="#2D2D2D" BorderThickness="1" Margin="8" Padding="20">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="VIRTUAL CONTROLLER 4" FontSize="11" FontWeight="Bold" Foreground="#444444" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SlotIcon4" Text="🎮" FontSize="42" HorizontalAlignment="Center" Margin="0,12"/>
                        <TextBlock x:Name="SlotTxt4" Text="Disconnected" FontSize="13" Foreground="#444444" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock x:Name="TxtTotalConnected" Grid.Row="2" Text="Total Connected: 0 / 4" FontSize="12" Foreground="#666666" HorizontalAlignment="Right" Margin="0,16,8,0"/>
        </Grid>
    </Grid>
</Window>
